{
    "name": "ROS2 Humble Dev Container",

    "build": {
        "dockerfile": "Dockerfile"
    },

    "initializeCommand": "cd ${localWorkspaceFolder} && ln -sfn \"$(cd \"$(git rev-parse --git-common-dir)/..\" && pwd)/test_turtlebot3_src\" ./test_turtlebot3_src",

    "runArgs": [
        "--cap-add=SYS_PTRACE",
        "--security-opt=seccomp=unconfined",
        "--net=host",
        "--ipc=host",
        "--gpus", "all",
        "--shm-size=512m",
        "-e", "DISPLAY=${env:DISPLAY}"
    ],

    "containerEnv": {
        "NVIDIA_VISIBLE_DEVICES": "all",
        "NVIDIA_DRIVER_CAPABILITIES": "all",
        "QT_X11_NO_MITSHM": "1",
        "ROS_LOCALHOST_ONLY": "1",
        "IGN_IP": "127.0.0.1",
        "GAZEBO_IP": "127.0.0.1",
        "RMW_IMPLEMENTATION": "rmw_zenoh_cpp"
    },

    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

    "shutdownAction": "stopContainer",

    "mounts": [
        "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind",
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
        "source=${localWorkspaceFolder}/test_turtlebot3_src,target=/opt/turtlebot3_ws,type=bind"
    ],

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "ms-vscode.cpptools",
                "ms-iot.vscode-ros",
                "redhat.vscode-yaml"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "terminal.integrated.profiles.linux": {
                    "bash": {
                        "path": "/bin/bash",
                        "args": ["-l"]
                    }
                },
                "python.defaultInterpreterPath": "/workspaces/${localWorkspaceFolderBasename}/.venv/bin/python",
                "python.analysis.extraPaths": [
                    "/opt/ros/humble/lib/python3.10/site-packages"
                ],
                "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
                "files.associations": {
                    "*.repos": "yaml"
                }
            }
        }
    },

    "postCreateCommand": "LOCAL_WORKSPACE_FOLDER_BASENAME=${localWorkspaceFolderBasename} bash -l .scripts/post_create.sh",

    "remoteUser": "vscode",

    "remoteEnv": {
        "SSH_AUTH_SOCK": "/ssh-agent"
    }
}